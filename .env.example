APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Hosts whose site root (/) redirects to /onboarding. Any other host,
# including app.just-drive.co.uk, redirects / to /booking.
# ONBOARDING_ENTRY_HOSTS=app.drive-plus.co.uk

# Login and dashboard on these hosts redirect to APP_CANONICAL_URL.
# The path and query string are kept. Other routes stay on the host that
# received them. Defaults: https://app.drive-plus.co.uk and
# app.just-drive.co.uk.
# APP_CANONICAL_URL=https://app.drive-plus.co.uk
# APP_AUTH_REDIRECT_HOSTS=app.just-drive.co.uk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Transactional email is sent via Resend. After adding RESEND_API_KEY,
# all Mailables and Notifications use this mailer. MAIL_FROM_ADDRESS must
# be on a domain verified in the Resend dashboard.
# Use MAIL_MAILER=log locally if you do not want live sends.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENROUTER_API_KEY=
OPENROUTER_MODEL=amazon/nova-lite-v1
OPENROUTER_MAX_TOKENS=1024

# Google tracking on the public /booking page. Defaults live in
# config/services.php; override here only if the property IDs change.
# GTM_CONTAINER_ID=
# GOOGLE_ADS_ID=AW-10884289539
# GOOGLE_GA4_ID=G-NBYWT0EZF6

# Booking & digital fees. See config/fees.php.
# When FEES_OVERRIDE_TO_ZERO=true, both fees are treated as £0 across the
# pricing pipeline (checkout preview, order creation, package accessors).
# The BOOKING_FEE and DIGITAL_FEE_PER_LESSON values are still honoured when
# the override is switched back off.
# BOOKING_FEE=19.99
# DIGITAL_FEE_PER_LESSON=3.99
# FEES_OVERRIDE_TO_ZERO=false

VITE_APP_NAME="${APP_NAME}"

# Show the MTD (Making Tax Digital) button in the instructor layout header.
# Defaults to false — set to true to expose the HMRC / Tax button to instructors.
SHOW_MTD_BUTTON=false

# HMRC Making Tax Digital. Sandbox until production credentials are approved.
# HMRC_ENVIRONMENT=sandbox
# HMRC_CLIENT_ID=
# HMRC_CLIENT_SECRET=
# HMRC_REDIRECT_URI="${APP_URL}/hmrc/oauth/callback"

# Fraud-prevention headers (WEB_APP_VIA_SERVER).
# Public IP of the TLS edge the browser connects to. Required for a clean
# Test Fraud Prevention Headers result.
# HMRC_VENDOR_PUBLIC_IP=
# HMRC_VENDOR_PRODUCT_NAME="Drive CRM"
# HMRC_VENDOR_VERSION=1.0.0
# HMRC_VENDOR_VERSION_KEY=drivecrm
# HMRC_USER_ID_KEY=drivecrm
# Set only if the product issues a license key. Hashed into Gov-Vendor-License-IDs.
# HMRC_VENDOR_LICENSE_KEY=
# Header a reverse proxy sets to the client's TCP source port (not 80 or 443).
# HMRC_CLIENT_PUBLIC_PORT_HEADER=
# Comma-separated proxy addresses, or * . Needed so Gov-Client-Public-IP is the
# instructor's address rather than the load balancer.
# TRUSTED_PROXIES=
